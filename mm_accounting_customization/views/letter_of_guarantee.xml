<odoo>
    <record id="view_mm_letter_of_guarantee_search" model="ir.ui.view">
        <field name="name">mm.letter.of.guarantee.search</field>
        <field name="model">mm.letter.of.guarantee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="date"/>
                <separator/>
                <filter name="filter_date" date="date"/>
                <field name="journal_id" domain="[('type', 'in', ('bank', 'cash'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Journal" name="journal" context="{'group_by': 'journal_id'}"/>
                    <filter string="Status" name="status" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="mm_letter_of_guarantee_view_list" model="ir.ui.view">
        <field name="name">mm.letter.of.guarantee.view.list</field>
        <field name="model">mm.letter.of.guarantee</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
<!--
                <field name="letter_of_guarantee"/>
-->
                <field name="letter_amount"/>
                <field name="insurance_account_id" invisible="status== 'fc'" />
                <field name="type"/>
                <field name="status"/>
                <field name="state" string="Stage"/>
            </list>
        </field>
    </record>

    <record id="mm_letter_of_guarantee_view_form" model="ir.ui.view">
        <field name="name">mm.letter.of.guarantee.view.form</field>
        <field name="model">mm.letter.of.guarantee</field>
        <field name="arch" type="xml">
            <form>
                <header>
                     <button name="action_approve" type="object"  class="oe_highlight" string="Approve"/>
                    <button name="action_cancel" type="object" invisible="state=='draft'" class="oe_highlight" string="Cancel"/>
                    <button name="%(mm_accounting_customization.action_mm_extension_wizard)d"
        type="action" string="Extension" class="oe_highlight"
        invisible="is_seepage==True or is_recovery==True or state in ['draft', 'cancel']"
        context="{'default_letter_of_guarantee_id': id}"/>

                    <button name="action_recovery" type="object"  class="oe_highlight" string="Recovery" invisible="is_seepage== True or is_recovery== True or state in ['draft', 'cancel']"/>
                     <button name="action_insurance_reduction" type="object"  class="oe_highlight" string="Insurance Reduction" invisible="state not in ['approve', 'extension', 'ramping']"/>
                    <button name="action_seepage" type="object" class="oe_highlight" string="Seepage" invisible="is_seepage== True or is_recovery== True or state in ['draft', 'cancel']"/>
                   <button name="%(mm_accounting_customization.action_mm_ramping_wizard)d"
                            type="action" string="Ramping" class="oe_highlight" invisible="is_seepage== True or is_recovery==True or state in ['draft', 'cancel'] or status== 'fc'"
                            context="{'default_letter_of_guarantee_id': id}"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,approve"/>
                </header>
                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button name="open_journal_entries" type="object" class="oe_stat_button" icon="fa-bars"
                                invisible="journal_entries_count== 0">
                            <field name="journal_entries_count" string="Journal Entries" widget="statinfo"/>
                        </button>
                    </div>
                    <label for="name" class="oe_edit_only"/>
                    <h2>
                        <field name="name" readonly="is_group_access_seq== False"/>
                    </h2>
                    <group>
                        <group>
                            <field name="is_group_access_seq" invisible="1"/>
                            <field name="partner_id" required="0" readonly="state !='draft'"/>
                            <field name="journal_id" required="1" readonly="state !='draft'"/>
                            <field name="end_date" required="1" readonly="state != 'draft'"/>
                            <field name="notes" required="1" readonly="state != 'draft'"/>
                            <field name="move_ids" invisible="1"/>
                            <field name="is_extension" invisible="1"/>
                            <field name="is_recovery" invisible="1"/>
                            <field name="is_seepage" invisible="1"/>
                            <field name="run_compute" invisible="1"/>
                            <field name="is_ramping" invisible="1"/>
                            <field name="letter_amount" invisible="1"/>
                            <field name="insurance_account_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date" required="1" readonly="state != 'draft'"/>
                            <field name="type" required="1" readonly="state != 'draft'"/>
                            <field name="status" required="1" readonly="state != 'draft'"/>
                            <field name="final_insurance_account" invisible="1"/>
                            <field name="reduced" readonly="1" invisible="1"/>
                            <field name="remaining_value_wiz" readonly="1" invisible="1"/>
                            <field name="remaining_value"/>
                            <field name="recovery_expense" readonly="state not in ['draft', 'approve', 'extension']"/>
                        </group>
                    </group>
                    <notebook>
                        <page id="tab" string="Account" groups="mm_accounting_customization.group_access_debit_credit">
                            <field name="letter_of_guarantee_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <!-- <field name="link_id" invisible="0"/> -->
                                    <field name="account_id"/>
                                    <field name="debit" sum="total_debit"/>
                                    <field name="credit" sum="total_credit"/>
                                </list>
                            </field>
                        </page>
                        <page id="extension" string="Extension">
                            <field name="extension_ids" readonly="0">
                                <list editable="bottom">
                                    <!-- <field name="link_id" invisible="0"/> -->
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="ramping"/>
                                    <field name="move_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div> -->
            </form>
        </field>
    </record>

    <record id="mm_letter_of_guarantee_action" model="ir.actions.act_window">
        <field name="name">Letter Of Guarantee</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mm.letter.of.guarantee</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sub_mm_letter_of_guarantee" name="Letter Of Guarantee" parent="account.menu_finance_reports"
              action="mm_letter_of_guarantee_action" sequence="100"/>

</odoo>