        <record id="mm_account_payment_form_inherit" model="ir.ui.view">
            <field name="name">account.payment.form.inherit</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="run_compute" invisible="1"/>
                    <field name="portal_id"/>
                </xpath>
            </field>
        </record>
        <record id="mm_account_payment_list_inherit" model="ir.ui.view">
            <field name="name">account.payment.list.inherit</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="portal_id"/>
                </xpath>
            </field>
        </record>
        <record id="mm_stock_move_line_list_inherit" model="ir.ui.view">
            <field name="name">stock.move.line.list.inherit</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='location_dest_id']" position="after">
                    <field name="is_has_cost" invisible="1"/>
                    <field name="lst_price"/>
                    <field name="cost_per_unit" invisible="is_has_cost== False"/>
                    <field name="total_cost" invisible="is_has_cost== False"/>
                    <field name="picking_partner_id"/>
                </xpath>
            </field>
        </record>
        <record id="mm_stock_move_line_form_inherit" model="ir.ui.view">
            <field name="name">stock.move.line.form.inherit</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='location_dest_id']" position="after">
                    <field name="is_has_cost" invisible="1"/>
                    <field name="lst_price"/>
                    <field name="cost_per_unit" invisible="is_has_cost== False"/>
                    <field name="total_cost" invisible="is_has_cost== False"/>
                    <field name="picking_partner_id"/>
                </xpath>
            </field>
        </record>
        <record id="mm_stock_move_list_inherit" model="ir.ui.view">
            <field name="name">stock.move.list.inherit</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_move_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='location_dest_id']" position="after">
                    <field name="is_has_cost" invisible="1"/>
                    <field name="lst_price"/>
                    <field name="standard_price" invisible="is_has_cost== False"/>
                    <field name="partner_id" string="Destination Address "/>
                </xpath>
            </field>
        </record>
        <record id="mm_stock_move_form_inherit" model="ir.ui.view">
            <field name="name">stock.move.form.inherit</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='location_dest_id']" position="after">
                    <field name="is_has_cost" invisible="1"/>
                    <field name="lst_price"/>
                    <field name="standard_price" invisible="is_has_cost==False"/>
                    <field name="partner_id" string="Destination Address "/>
                </xpath>
            </field>
        </record>
        <record id="mm_product_template_form_inherit" model="ir.ui.view">
            <field name="name">product.template.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='general_information']//field[@name='standard_price']" position="after">
                    <field name="is_has_cost" invisible="1"/>
                </xpath>
                <xpath expr="//page[@name='general_information']//label[@for='standard_price']" position="attributes">
                    <attribute name="invisible">is_has_cost== False</attribute>
                </xpath>
                <xpath expr="//page[@name='general_information']//field[@name='standard_price']" position="attributes">
                    <attribute name="invisible">is_has_cost== False</attribute>
                </xpath>
            </field>
        </record>
        <record id="mm_product_template_list_inherit" model="ir.ui.view">
            <field name="name">product.template.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_variant_count']" position="after">
                    <field name="is_has_cost" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='standard_price']" position="attributes">
                    <attribute name="invisible">is_has_cost== False</attribute>
                </xpath>
            </field>
        </record>
        <record id="mm_product_product_list_inherit" model="ir.ui.view">
            <field name="name">product.product.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_product_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='default_code']" position="after">
                    <field name="is_has_cost" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='standard_price']" position="attributes">
                    <attribute name="invisible">is_has_cost== False</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>