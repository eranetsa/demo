                </xpath> -->
                <!-- <xpath expr="//button[@name='action_register_payment']" position="attributes">
                    <attribute name="context">{'dont_redirect_to_payments': True,'default_move_mm_test_id': active_id}</attribute>
                </xpath> -->
                <xpath expr="//field[@name='name']" position="after">
                    <field name="is_group_access_seq" invisible="1"/>
                </xpath>
                
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="get_cash_guarantee" type="object" class="oe_stat_button" icon="fa-exchange"
                            invisible="move_type!= 'out_invoice'">
                        <field name="cash_guarantee_count" string="Cash Guarantee"  widget="statinfo"/>
                    </button>
                </xpath>
            </field>
        </record>

