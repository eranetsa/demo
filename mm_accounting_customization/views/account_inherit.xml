        <record id="mm_account_journal_form_view_i" model="ir.ui.view">
            <field name="name">account.journal.form</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='type']" position="after">
                    <field name="insurance_account_id" invisible="type not in ['bank', 'cash']"/>
                    <field name="bank_facility_account_id" invisible="type!='bank'"/>
                    <field name="expense_account_id" invisible="type not in['bank', 'cash', 'general']"/>
                </xpath>
            </field>
        </record>

        <record id="mm_account_move_form_inherit" model="ir.ui.view">
            <field name="name">account.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_reference']" position="after">
                    <field name="portal_id"/>
                    <field name="notes"/>
                    <field name="letter_of_guarantee_id" invisible="1"/>
                    <field name="insurance_ids" widget="many2many_tags" invisible="1"/>
                </xpath>
                <!-- <xpath expr="//header" position="inside">
                    <button name="%(mm_accounting_customization.action_mm_cash_guarantee_wizard)d"
                            type="action" string="Cash Guarantee" class="oe_highlight"
                            invisible="state!= 'posted' or payment_state not in ['not_paid','partial'] or move_type not in ['out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt']"
                            context="{'default_partner_id': partner_id, 'default_journal_id': journal_id, 'default_date': invoice_date, 'default_move_id': active_id,}"
